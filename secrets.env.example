# Copy to secrets.env (repo root, or inside one show folder). chmod 600.
# secrets.env is gitignored. Do not commit it. Do not put these values in config.env.
#
# A value already set in the environment wins over this file, which is how
# GitHub Actions and a server pass the same settings without a file.
#
# Claude. One of these is enough. Without either, episodes still publish,
# with show notes built from the YouTube description.
#   claude setup-token     prints a one-year token. Paste it as CLAUDE_CODE_OAUTH_TOKEN.
#   console.anthropic.com  creates ANTHROPIC_API_KEY (billed per request).
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# Optional model for the direct API path. The default is claude-sonnet-4-5.
ANTHROPIC_MODEL=

# WordPress application password for the REST path (required on a server or
# GitHub Actions; the Mac can keep using .wp.env for AI Samachar and the
# novamira CLI login for Block Talks). Use the show folder's secrets.env
# when the two sites have different users.
WP_API_USERNAME=
WP_API_PASSWORD=

# Google Sheet via the Composio CLI. The Mac can keep using `composio login`.
# A server needs the key, and non-interactive login also needs the org and project.
COMPOSIO_API_KEY=
COMPOSIO_ORG_ID=
COMPOSIO_PROJECT_ID=

# Podcast Index API (optional). Without it, Podverse's copy of the index is used.
PI_API_KEY=
PI_API_SECRET=

# Per-show sheet. config.env has a placeholder; set the real id here or in the environment.
SHEET_ID=

# Alerts. osascript notifications still run on the Mac when this is unset.
# NOTIFY_HOOK is a zsh snippet. $TITLE, $BODY, $1 and $2 are the failure title and message.
# NOTIFY_HOOK='curl -fsS -X POST --data-binary "$BODY" "$SLACK_WEBHOOK_URL"'
NOTIFY_HOOK=
# Or set a Slack incoming-webhook URL and the jobs post to it themselves.
SLACK_WEBHOOK_URL=

[Unit]
Description=Block Talks podcast check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/podcast-distribution/blockopedia-podcast
ExecStart=/bin/zsh /opt/podcast-distribution/blockopedia-podcast/check.sh
EnvironmentFile=-/opt/podcast-distribution/secrets.env
Nice=10

# AI Samachar auto-publish settings. Edit and save; the next check picks them up.

# YouTube playlist that feeds the podcast: "AI Samachar: Daily AI News (Hinglish)" on @Rankkking.
PLAYLIST_ID=PLCBOIQlZNRSE

# The playlist also holds each day's Short; only videos at least this long become episodes.
MIN_MINUTES=3

# WordPress site (Novamira connection name), the show's series and its own feed.
# The site's default feed redirects to Block Talks; AI Samachar never uses it.
SITE=podcast.rankkking.com
SERIES=ai-samachar
FEED_URL=https://podcast.rankkking.com/feed/podcast/ai-samachar/

# Media library ID of the square AI Samachar cover, used when a YouTube thumbnail can't be fetched.
COVER_ID=15

# draft   = new episodes are saved as drafts; publish them in wp-admin › Podcast.
# publish = new episodes go live straight away and reach every platform.
MODE=publish

# Most new videos to process in one check (the rest wait for the next check).
MAX_PER_RUN=6

# Google Sheet tracker (written through Composio as the Google account connected in Composio).
SHEET_ID=YOUR_GOOGLE_SHEET_ID

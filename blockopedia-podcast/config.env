# Block Talks auto-publish settings. Edit and save; the next check picks them up.

# YouTube playlist that feeds the podcast.
PLAYLIST_ID=PLVYQlUuf_b9qTsxYkMax2DdaDvtyzgmmn

# Channel uploads also feed the podcast, without being added to the playlist: a video
# counts when its title contains CHANNEL_MATCH, it runs at least MIN_MINUTES, and it was
# uploaded on or after CHANNEL_SINCE (YYYYMMDD). Only the latest CHANNEL_SCAN uploads are
# looked at. Leave CHANNEL_ID empty to use the playlist alone.
CHANNEL_ID=UCGj-snjowS_xjGbLmgafA6g
CHANNEL_MATCH="TBP Podcast"
MIN_MINUTES=5
CHANNEL_SINCE=20261019
CHANNEL_SCAN=30

# WordPress site (Novamira connection name) and the podcast feed.
SITE=theblockopedia.com
FEED_URL=https://theblockopedia.com/feed/podcast/the-blockopedia/

# draft   = new episodes are saved as drafts; publish them in wp-admin › Podcast.
# publish = new episodes go live straight away and reach every platform.
MODE=draft

# Most new videos to process in one check (the rest wait for the next check).
MAX_PER_RUN=2

# Google Sheet tracker, written through Composio.
SHEET_ID=YOUR_GOOGLE_SHEET_ID
